{
  "name": "beat-rehab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
