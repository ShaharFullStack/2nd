# Harness OUTPUT is regenerated by every run: tracking it means every verification
# dirties the tree, and a screenshot in a commit is not evidence of anything anyway.
# CI uploads these as build artifacts instead; progress/shots holds the curated few.
critic/screenshots/*.png
critic/screenshots/**/*.png
critic/handsfree/
critic/handsfree-thigh/
critic/frames/
critic/motion/
critic/_tmp_*
critic/scratch/
.critic-tmp/
