{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/|models/|wasm/|songs/|favicon|icons).*)", "destination": "/index.html" }],
  "headers": [
    {
      "comment": "Hashed build output: safe to cache forever.",
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "comment": "MediaPipe models and wasm runtime: ~47 MB, versioned by the package, never edited in place. A clinic tablet should download these once, not once per session.",
      "source": "/(models|wasm)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "comment": "Song stems are large and immutable per song id; the manifest may change, so revalidate it.",
      "source": "/songs/(.*)/stems/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/songs/(.*).json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "comment": "The camera never leaves the device and nothing is uploaded; say so in the headers too.",
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
